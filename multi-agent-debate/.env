# ── Multi-Agent Debate Configuration ──────────────────────────────────────────
# Model used for both debater agents AND the judge (same model, different roles)
DEBATE_MODEL=llama3.2
JUDGE_MODEL=llama3.2

# Number of debate rounds (each side argues once per round)
DEBATE_ROUNDS=2

# Ollama host (default: local)
OLLAMA_HOST=http://localhost:11434
